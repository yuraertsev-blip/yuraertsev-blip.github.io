айване.",{"gongfu":55,"western":62,"vessel":65,"tips":66},{"grams":56,"ml":57,"temp":58,"first":59,"add":60,"steeps":61},6,100,95,15,5,7,{"grams":60,"ml":63,"temp":58,"minutes":64},300,3,"Гайвань или глиняный чайник","Первый пролив сливайте: он раскрывает тугие шарики листа.","Весна 2026",{"id":7,"name":69,"cn":70,"pinyin":71,"liquor":72,"ink":73,"temp":74,"short":75,"description":76,"stage":77,"order":24},"Улун","乌龙","wū lóng","#d4a14b","dark","90–100 °C","От цветочных до прожаренных, утёсных","Полуферментированный чай: лист встряхивают и окисляют частично, от 15 до 70 %. Отсюда весь диапазон — от сиреневых улунов Аньси до прожаренных утёсных чаёв Уишаня.",null,[79,119,147,181],{"id":80,"slug":80,"name":81,"cn":82,"pinyin":83,"translation":84,"category":7,"subtype":85,"province":86,"region":87,"year":11,"short":88,"taste":89,"variants":93,"priceFrom":97,"inStock":23,"featured":23,"order":60,"images":102},"ulun-vysokogornyj-yunnan","Улун высокогорный из Юньнани","云南高山乌龙","Yúnnán Gāoshān Wūlóng","Высокогорный улун из Юньнани","","Юньнань","Сады выше 1500 метров","Светлый улун с высокогорных садов Юньнани. Сирень, сливки, свежая зелень.",[90,91,92],"сирень","сливки","зелень",[94,98],{"id":95,"label":96,"price":97,"out":22},"v1kr8g8","50 г",838,{"id":99,"label":100,"price":101,"out":22},"v39r1cy","90 г",1380,[103,111],{"id":104,"ext":-1,"w":28,"h":29,"widths":105,"blur":106,"color":107,"alt":36,"credit":108},"tieguanyin-2",[31,32,33],"data:image/webp;base64,","#f8f8f8",{"text":109,"url":110,"license":51},"\"Fulles de Tieguanyin\" by Francesc Fort, CC BY-SA 4.0, via Wikimedia Commons","https://openverse.org/image/8c89661e-e8f6-4981-af2f-529bc80e07a4",{"id":112,"ext":-1,"w":28,"h":113,"widths":114,"blur":115,"color":46,"alt":36,"credit":116},"tieguanyin-3",2332,[31,32,33],"data:image/webp;base64,",{"text":117,"url":118,"license":51},"\"Té Tieguanyin\" by Francesc Fort, CC BY-SA 4.0, via Wikimedia Commons","https://openverse.org/image/39e181d8-7136-4d89-b58b-a3409725021b"