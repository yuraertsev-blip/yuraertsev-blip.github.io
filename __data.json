{"type":"data","nodes":[null,{"type":"data","data":[{"settings":1,"footerPhoto":32},{"brand":2,"contacts":6,"delivery":13,"home":16,"ceremoniesPage":26,"catalogPhoto":31},{"name":3,"cn":4,"descriptor":5},"Юньча","云茶","чайный дом",{"phone":7,"person":8,"telegram":9,"whatsapp":9,"email":9,"city":10,"address":11,"hours":12},"+7 921 027-50-02","Вячеслав","","Великий Новгород","Розважа 13, «Ю кофе»","ежедневно 10:00–20:00",{"text":14,"freeFrom":15},"Отправляем по России СДЭК и Почтой в день заказа. По Великому Новгороду — курьером на следующий день, самовывоз из «Ю кофе» ежедневно.",5000,{"heroTitle":17,"heroText":18,"stage":19,"listPhoto":24,"ctaPhoto":21,"footerPhoto":25},"Чай, рождённый в облаках","Листовой китайский чай из горных садов Юньнани, Фуцзяни и Чжэцзяна — и чайные церемонии, на которые можно прийти или пригласить мастера к себе.",[20,21,22,23],"stage-teapot","wuyi-mist","gongfu-tray","gongfu-pour","wuyi-scroll","song-leaf-bowl",{"stage":27},[23,28,22,29,30],"tea-utensils","afong-taking-tea","song-tea-fighting","botanical-plate",{"id":25,"ext":-1,"w":33,"h":34,"widths":35,"blur":39,"color":40,"alt":41,"credit":42},3919,2940,[36,37,38],480,960,1600,"data:image/webp;base64,UklGRnwAAABXRUJQVlA4IHAAAADQBACdASoYABIAPu1grFAppSQisBgIATAdiWUAzuwQqmaAm6eVzffUHmKBXfuUAAD+3pQH5+l/7M5cvtQiMt4/i4EGkoAgj+BsYpJ/ifoumDRD3TLRciFJFhaNtE9xgxCInlj+IpS90cHaaEB5iAAA","#c8c8c8","Чаша для чая с отпечатком листа, Китай, XII–XIII век",{"text":43,"url":44,"license":45},"\"Tea Bowl with Leaf Decoration\" by China maker, 12th–13th century, public domain (CC0), via The Metropolitan Museum of Art","https://www.metmuseum.org/art/collection/search/51079","CC0"],"uses":{}},{"type":"data","data":[{"stage":1,"listPhoto":51,"ctaPhoto":61,"categories":62,"counts":125,"menu":127,"next":170,"total":181},[2,15,29,40],{"id":3,"ext":-1,"w":4,"h":5,"widths":6,"blur":8,"color":9,"alt":10,"credit":11},"stage-teapot",683,1024,[7,4],480,"data:image/webp;base64,","#080808","Исинский глиняный чайник и пиалы