HPgSVqzTTGd7rw/j0/AMeVmraRh4jMihI4Gofr0RSgnB2IsBiNgihv4Cdg9gdb4atFDJ0IWAA==","#b88848","Горы Уишань на старинном китайском свитке",{"text":59,"url":60,"license":14},"\"Sixth Nine Bends, WuYi Mountain\" by lacma, CC0, via rawpixel","https://openverse.org/image/001c5da1-3c3d-4ed0-b630-515015602e1a",{"id":16,"ext":-1,"w":17,"h":18,"widths":19,"blur":22,"color":23,"alt":24,"credit":25},[63,74,84,94,104,115],{"id":64,"name":65,"cn":66,"pinyin":67,"liquor":68,"ink":69,"temp":70,"short":71,"description":72,"order":73},"green","Зелёный","绿茶","lǜ chá","#cfca8a","dark","75–85 °C","Свежий, травянистый, с ореховой сладостью","Лист не окисляют: сразу после сбора его прогревают в котле, чтобы сохранить свежесть. Настой светлый, вкус травянистый и ореховый, с лёгкой сладостью в послевкусии.",1,{"id":75,"name":76,"cn":77,"pinyin":78,"liquor":79,"ink":69,"temp":80,"short":81,"description":82,"order":83},"white","Белый","白茶","bái chá","#e5d6a6","85–90 °C","Мягкий, медовый, с ароматом луговых цветов","Самая простая обработка: почки и молодые листья только вялят и сушат. Настой мягкий и медовый, а выдержанный белый чай с годами становится глубже и слаще.",2,{"id":85,"name":86,"cn":87,"pinyin":88,"liquor":89,"ink":69,"temp":90,"short":91,"description":92,"order":93},"yellow","Жёлтый","黄茶","huáng chá","#e3c45f","80–85 °C","Бархатный, без горечи, с хлебной нотой","Редкое семейство: после прогрева лист томят под тканью, и он слегка желтеет. Вкус бархатный, без терпкости зелёного чая, с тёплой хлебной нотой.",3,{"id":95,"name":96,"cn":97,"pinyin":98,"liquor":99,"ink":69,"temp":100,"short":101,"description":102,"order":103},"oolong","Улун","乌龙","wū lóng","#d4a14b","90–100 °C","От цветочных до прожаренных, утёсных","Полуферментированный чай: лист встряхивают и окисляют частично, от 15 до 70 %. Отсюда весь диапазон — от сиреневых улунов Аньси до прожаренных утёсных чаёв Уишаня.",4,{"id":105,"name":106,"cn":107,"pinyin":108,"liquor":109,"ink":110,"temp":111,"short":112,"description":113,"order":114},"red","Красный","红茶","hóng chá","#8a2a1f","light","90–95 °C","Сладкий, хлебный, с нотами сухофруктов","То, что в Европе называют чёрным: лист окисляют полностью. В Китае его зовут красным — по цвету настоя. Вкус сладкий и хлебный, с нотами мёда и сухофруктов.",5,{"id":116,"name":117,"cn":118,"pinyin":119,"liquor":120,"ink":110,"temp":121,"short":122,"description":123,"order":124},"puer","Пуэр","普洱","pǔ ěr","#4a2016","95–100 °C","Выдержанный, глубокий, землистый","Чай из Юньнани, который прессуют в блины и выдерживают годами. Шэн стареет естественно и с годами темнеет, шу ферментируют ускоренно — он сразу густой, землистый, согревающий.",6,{"green":126,"white":73,"yellow":126,"oolong":103,"red":73,"puer":73},0,[128,136,155,163],{"id":75,"name":76,"cn":77,"teas":129},[130],{"slug":131,"name":132,"short":133,"price":134,"unit":135},"baj-mu-dan","Бай Му Дань","Почка с двумя листьями, как бутон среди лепестков. Луговые травы и абрикос.",598,"40 г",{"id":95,"name":96,"cn":97,"teas":137},[138,144,150],{"slug":139,"name":140,"short":141,"price":142,"unit":143},"ulun-vysokogornyj-yunnan","Улун высокогорный из Юньнани","Светлый улун с высокогорных садов Юньнани. Сирень, сливки, свежая зелень.",838,"50 г",{"slug":145,"name":146,"short":147,"price":148,"unit":149},"ulun-gaba-fermerskaya","Улун Габа фермерский","Улун особой обработки без кислорода. Печёные фрукты, мёд, корица, лёгкая кислинка.",1565,"80 г",{"slug":151,"name":152,"short":153,"price":154,"unit":135},"dun-din","Дун Дин","Тайваньский улун средней прожарки. Карамель, жареный рис, спелый персик.",694,{"id":105,"name":106,"cn":107,"teas":156},[157],{"slug":158,"name":159,"short":160,"price":161,"unit":162},"dyan-hun","Золотая игла","Золотые почки, скрученные в иглы. Мёд, печёный батат, какао. Первая категория.",2685,"90 г",{"id":116,"name":117,"cn":118,"teas":164},[165],{"slug":166,"name":167,"short":168,"price":169,"unit":143},"pochki-ya-bao","Почки Я Бао","Нераскрытые почки диких юньнаньских деревьев. Сосновая смола, цитрус, мёд.",828,{"id":171,"published":172,"title":173,"date":174,"duration":175,"place":176,"address":177,"price":178,"seats":179,"seatsLeft":93,"description":180},"c1",true,"Осенние улуны: от Аньси до Уишаня","2026-10-24T15:00",120,"Чайная комната в «Ю кофе»","Великий Новгород, Розважа 13",2500,8,"Улуны из нашей коллекции: высокогорный юньнаньский, Дун Дин, Габа и Фэн Хуан Дань Цун. Учимся слышать окисление и прожарку.",7],"uses":{}}]}
